# Send the charset in the HTTP Content-Type header (e.g. text/html; charset=UTF-8)
AddDefaultCharset UTF-8
AddCharset UTF-8 .css .js .xml .txt

RewriteEngine On

# One canonical host: force HTTPS and strip "www."
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://vanguardglobalmigration.com/$1 [R=301,L]

# Serve /index.html as /
RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://vanguardglobalmigration.com/$1 [R=301,L]
